{
  "name": "rifm",
  "version": "0.12.1",
  "packageManager": "pnpm@10.34.5",
  "description": "Tiny react input formatter and mask",
  "author": "istarkov",
  "maintainers": [
    "istarkov",
    "TrySound"
  ],
  "license": "MIT",
  "main": "dist/rifm.cjs.js",
  "module": "dist/rifm.esm.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:code": "rollup -c",
    "build:flow": "echo \"// @flow\n\nexport * from '../src'\" > dist/rifm.cjs.js.flow",
    "build": "rimraf dist && pnpm run build:code && pnpm run build:flow",
    "dev": "NODE_ICU_DATA=`pnpm exec node-full-icu-path` next dev",
    "jest": "NODE_ICU_DATA=`node -e \"const icu = require('full-icu'); if (icu.haveDat()) process.stdout.write(icu.datPath())\"` jest",
    "test": "flow check && pnpm run test:ts && pnpm run jest",
    "test:ts": "tsc",
    "copy-sandbox-examples": "mkdir -p ./docs/codesandboxes && find ./pages -type d -mindepth 1 -maxdepth 1 -exec cp -R \\{\\} ./docs/codesandboxes \\;",
    "export": "rimraf ./docs ./.next && NODE_OPTIONS=--openssl-legacy-provider next build && next export -o docs && pnpm run copy-sandbox-examples && touch ./docs/.nojekyll",
    "deploy": "pnpm run export",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm test && pnpm run build"
  },
  "babel": {
    "presets": [
      "next/babel",
      "@babel/flow",
      "@babel/react"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{js,md,ts,tsx}": "oxfmt --write"
  },
  "devDependencies": {
    "@babel/core": "^7.9.6",
    "@babel/preset-env": "^7.9.6",
    "@babel/preset-flow": "^7.9.0",
    "@babel/preset-react": "^7.9.4",
    "@material-ui/core": "^4.0.0",
    "@material-ui/styles": "^4.0.0",
    "@rollup/plugin-babel": "^5.0.2",
    "@rollup/plugin-replace": "^2.3.2",
    "@types/react": "16.7.18",
    "alea": "^0.0.9",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^26.0.1",
    "brotli-size": "^4.0.0",
    "emotion": "^10.0.17",
    "flow-bin": "^0.109.0",
    "full-icu": "^1.3.0",
    "gzip-size": "^5.1.1",
    "jest": "^26.0.1",
    "libphonenumber-js": "^1.2.15",
    "nano-staged": "^0.9.0",
    "next": "^9.4.2",
    "oxfmt": "^0.63.0",
    "react": "^16.8.2",
    "react-dom": "^16.8.2",
    "react-test-renderer": "^16.8.2",
    "rimraf": "^2.6.1",
    "rollup": "^2.10.8",
    "rollup-plugin-terser": "^6.0.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^3.4.5"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TrySound/rifm.git"
  },
  "typings": "./src/index.d.ts"
}
